#!/bin/bash
#
# Offline stand-in for curl, used only by webfetch-cache-selftest.sh via
# NW_WEBFETCH_CURL. It parses the conditional-request headers the hooks send
# and answers from environment variables, so no assertion in that selftest
# ever opens a socket.
#
# Redirects are modelled the way curl really behaves, because whether a hook
# passes -L is the difference between observing the source URL's 301 and
# silently observing the target's 200 and its validators.
#
# Env:
#   STUB_ETAG            the validator the "origin" currently advertises
#   STUB_LAST_MODIFIED   likewise
#   STUB_FAIL            non-empty: exit 7, as curl does on a connect failure
#   STUB_HEAD_STATUS     status for the header-block (post-hook) call (200)
#   STUB_REDIRECT_TO     non-empty: the URL 301s here. Without -L the answer
#                        is that 301 and no validators; with -L it is the
#                        target's clean 200 and STUB_REDIRECT_ETAG.
#   STUB_REDIRECT_ETAG   the target's ETag, seen only when -L is passed

set -u

if [ -n "${STUB_FAIL:-}" ]; then
  exit 7
fi

WANT_STATUS=""
FOLLOW=""
INM=""
IMS=""
prev=""
for arg in "$@"; do
  case "$arg" in
    -L) FOLLOW=1 ;;
  esac
  case "$prev" in
    -H)
      case "$arg" in
        If-None-Match:\ *) INM="${arg#If-None-Match: }" ;;
        If-Modified-Since:\ *) IMS="${arg#If-Modified-Since: }" ;;
      esac
      ;;
    -w) WANT_STATUS=1 ;;
  esac
  prev="$arg"
done

ETAG_NOW="${STUB_ETAG:-}"
LMOD_NOW="${STUB_LAST_MODIFIED:-}"
STATUS_NOW="${STUB_HEAD_STATUS:-200}"

if [ -n "${STUB_REDIRECT_TO:-}" ]; then
  if [ -n "$FOLLOW" ]; then
    ETAG_NOW="${STUB_REDIRECT_ETAG:-}"
    LMOD_NOW=""
    STATUS_NOW=200
  else
    ETAG_NOW=""
    LMOD_NOW=""
    STATUS_NOW=301
  fi
fi

if [ -n "$WANT_STATUS" ]; then
  if [ "$STATUS_NOW" = "301" ]; then
    printf '301'
  elif [ -n "$INM" ]; then
    if [ "$INM" = "$ETAG_NOW" ]; then printf '304'; else printf '200'; fi
  elif [ -n "$IMS" ]; then
    if [ "$IMS" = "$LMOD_NOW" ]; then printf '304'; else printf '200'; fi
  else
    printf '200'
  fi
  exit 0
fi

printf 'HTTP/2 %s\r\n' "$STATUS_NOW"
printf 'content-type: text/html; charset=utf-8\r\n'
[ "$STATUS_NOW" = "301" ] && printf 'location: %s\r\n' "${STUB_REDIRECT_TO:-}"
[ -n "$ETAG_NOW" ] && printf 'etag: %s\r\n' "$ETAG_NOW"
[ -n "$LMOD_NOW" ] && printf 'last-modified: %s\r\n' "$LMOD_NOW"
printf '\r\n'
exit 0
